# Frontend (Next.js)
# NEXT_PUBLIC_API_URL is the backend base URL used from the browser (client fetches).
# INTERNAL_API_URL is optional and used by server components inside Docker; when
# running in docker compose set it to http://backend:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# INTERNAL_API_URL=http://backend:8000

# Backend
DATABASE_URL=postgresql+asyncpg://affiloom:affiloom@localhost:5432/affiloom
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:***@localhost:5672/
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=affiloom-assets

# Backend CORS: comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:3000

# Admin sync API. Leave empty in local dev to keep /api/admin/* disabled (503).
# Must be non-empty in production for the router to accept requests.
ADMIN_API_TOKEN=

# Sync pipeline knobs.
SYNC_MAX_ITEMS=500
MEILI_INDEX=products
MEILI_ENABLED=false
REDIS_ENABLED=false
RABBITMQ_ENABLED=false
RABBITMQ_EXCHANGE=affiloom.events
RABBITMQ_ROUTING_KEY=sync.completed

# Integration providers (read-only / sandbox — reserved for future milestones).
# Concrete adapters MUST call official partner APIs only; no scraping.
SHOPEE_PARTNER_ID=
SHOPEE_KEY=
TOKOPEDIA_PARTNER_ID=
TOKOPEDIA_KEY=
